            "pages": [
              "dashboard/overview",
              "dashboard/analytics",
              "dashboard/devices",
              "dashboard/feature-flags",
              "dashboard/feedback",
              "dashboard/billing",
              "dashboard/team-management",
              "dashboard/settings"
            ]
          }
        ]
      },
