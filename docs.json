    "global": {
      "anchors": [
        {
          "anchor": "GitHub",
          "href": "https://github.com/grantiva",
          "icon": "github"
        },
        {
          "anchor": "Dashboard",
          "href": "https://grantiva.io/dashboard",
          "icon": "chart-line"
        },
        {
          "anchor": "Status",
          "href": "https://grantiva-services.instatus.com",
          "icon": "signal"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@grantiva.io"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get Started",
      "href": "https://grantiva.io/get-started"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "claude",
      "cursor"
    ]
  },
  "redirects": [
    {
      "source": "/sdk/ios",
      "destination": "/sdk/installation"
    },
    {
      "source": "/testing",
      "destination": "/sdk/testing"
    },
    {
      "source": "/pricing",
      "destination": "/#pricing"
    },
    {
      "source": "/blog/:slug*",
      "destination": "/quickstart"
    },
    {
      "source": "/api-reference/org/webhook-endpoints",
      "destination": "/api-reference/webhooks/endpoints"
    }
  ],
  "footer": {
    "socials": {
      "github": "https://github.com/grantiva"
    }
  }
}
