{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Grantiva",
  "colors": {
    "primary": "#0D9373",
    "light": "#14B8A6",
    "dark": "#0F766E"
  },
  "favicon": "/favicon.ico",
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Getting Started",
