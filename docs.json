{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Grantiva",
  "colors": {
    "primary": "#0D9373",
    "light": "#14B8A6",
    "dark": "#0F766E"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "index",
              "quickstart",
              "simulator-setup",
              "quickstart-feedback",
              "quickstart-flags",
              "quickstart-vrt",
              "quickstart-webhooks"
            ]
          },
          {
            "group": "iOS SDK",
            "pages": [
              "sdk/installation",
              "sdk/attestation",
              "sdk/user-identity",
              "sdk/feedback",
              "sdk/feature-flags",
              "sdk/error-handling"
            ]
          },
          {
            "group": "CLI",
            "pages": [
              "cli/installation",
              "cli/configuration",
              "cli/commands",
              "cli/ci-integration"
            ]
          },
          {
            "group": "Concepts",
            "pages": [
              "concepts/attestation",
              "concepts/risk-scoring",
              "concepts/custom-claims",
              "concepts/webhooks",
              "concepts/security",
              "concepts/vrt"
            ]
          },
          {
            "group": "Dashboard",
            "pages": [
              "dashboard/overview",
              "dashboard/analytics",
              "dashboard/team-management"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "api-reference/introduction",
              "api-reference/authentication"
            ]
          },
          {
            "group": "Attestation",
            "pages": [
              "api-reference/attestation/challenge",
              "api-reference/attestation/validate"
            ]
          },
          {
            "group": "Feedback",
            "pages": [
              "api-reference/feedback/feature-requests",
              "api-reference/feedback/voting",
              "api-reference/feedback/comments",
              "api-reference/feedback/support-tickets"
            ]
          },
          {
            "group": "Feature Flags",
            "pages": [
              "api-reference/flags/get-flags"
            ]
          },
          {
            "group": "Analytics",
            "pages": [
              "api-reference/analytics/dashboard",
              "api-reference/analytics/devices",
              "api-reference/analytics/compliance",
              "api-reference/analytics/export"
            ]
          },
          {
            "group": "Webhooks",
            "pages": [
              "api-reference/webhooks/endpoints"
            ]
          },
          {
            "group": "Visual Regression Testing",
            "pages": [
              "api-reference/vrt/runs",
              "api-reference/vrt/baselines"
            ]
          },
          {
            "group": "Auth",
            "pages": [
              "api-reference/auth/cli-sessions"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "GitHub",
          "href": "https://github.com/grantiva",
          "icon": "github"
        },
        {
          "anchor": "Dashboard",
          "href": "https://grantiva.io/dashboard",
          "icon": "chart-line"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@grantiva.io"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get Started",
      "href": "https://grantiva.io/get-started"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "claude",
      "cursor"
    ]
  },
  "redirects": [
    { "source": "/sdk/ios", "destination": "/sdk/installation" },
    { "source": "/pricing", "destination": "/#pricing" },
    { "source": "/blog/:slug*", "destination": "/quickstart" }
  ],
  "footer": {
    "socials": {
      "x": "https://x.com/grantiva",
      "github": "https://github.com/grantiva"
    }
  }
}
